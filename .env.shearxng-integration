def brave_search(query: str) -> dict:
    # Redirects to local SearXNG at http://localhost:8084
    import requests
    response = requests.get(
        "http://localhost:8084/search",
        params={"q": query, "format": "json"},
        timeout=30
    ).json()
    return response
